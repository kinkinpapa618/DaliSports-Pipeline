# GEMINI API KEY (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=

# Model Gemini sử dụng (mặc định: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# (TÙY CHỌN) FACEBOOK GRAPH API - Nếu muốn upload Facebook không cần mở trình duyệt
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# (TÙY CHỌN) CLOUDFLARE TUNNEL - Domain truy cập từ xa
CLOUDFLARE_CUSTOM_DOMAIN=server.trongtaiso.com
# CLOUDFLARE_TUNNEL_TOKEN= (dán token khi dùng Named Tunnel cho server.trongtaiso.com)
